<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to hidden files and folders (except .well-known for SSL)
    RewriteRule "(^|/)\.(?!well-known)" - [F]

    # Redirect everything into public directory
    RewriteRule ^$ public/ [L]
    RewriteRule ((?s).*) public/$1 [L]
</IfModule>
